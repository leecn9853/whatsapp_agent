# DeepSeek API 配置
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Tavily API 配置
TAVILY_API_KEY="tvly-your-api-key-here"

# whatsapp_simulator 服务地址（用于 webhook 回复消息）
WHATSAPP_SIMULATOR_URL="http://localhost:3000"

# 模拟第三方数据服务（thrid_app）地址
THIRD_APP_BASE_URL="http://127.0.0.1:8800"

# Postgres（agent-server 用，本机 docker-compose 起的开发库）
POSTGRES_PASSWORD="change_me"
DATABASE_URL="postgresql://excel_agent:change_me@localhost:5432/excel_agent"

# Meta WhatsApp Cloud API webhook 验证令牌（自己随机生成，Meta 开发者后台配置 webhook 时要填同一个值）
WHATSAPP_META_VERIFY_TOKEN="abcdefg"

# Meta App Secret，用于校验 webhook POST 请求的 X-Hub-Signature-256 签名（Meta 开发者后台 App 设置里）
WHATSAPP_META_APP_SECRET="your_meta_app_secret_here"

# Meta System User 永久 access token（开发调试可先用后台首页 24 小时临时 token，正式环境必须换成永久 token）
WHATSAPP_META_ACCESS_TOKEN="your_meta_access_token_here"

# Meta WhatsApp 号码的 phone_number_id（Meta 开发者后台 WhatsApp > API 设置里）
WHATSAPP_META_PHONE_NUMBER_ID="your_phone_number_id_here"
