# HTTP 服务监听的端口
PORT=3000

# whatsapp-web.js 持久化登录会话（LocalAuth）的目录。
# 删除这个文件夹会强制重新扫码登录。
SESSION_PATH=./.wwebjs_auth

# 如果设置了，每个收到的事件（qr、ready、message、message_ack、disconnected、auth_failure）
# 都会以 JSON 形式 POST 到这个 URL：{ event, data, timestamp }
WEBHOOK_URL=

# 不希望通过 webhook 推送的事件，逗号分隔。默认排除 qr
# （二维码建议直接用 GET /qr 接口获取，没必要每次刷新都推送）。
# 留空表示不排除任何事件，qr 也会被推送。
WEBHOOK_EXCLUDE_EVENTS=qr

# 可选：指定已安装的 Chrome/Chromium 路径，让 Puppeteer 复用它，
# 而不是自己下载一份内置 Chromium（能省约 300MB，也能避开某些 ARM Mac 上的问题）。
# 示例（macOS）：/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_EXECUTABLE_PATH=
